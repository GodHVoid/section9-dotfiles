#!/usr/bin/env bash

set -u

ok() {
  printf '\033[1;32mOK\033[0m      %s\n' "$*"
}

warn() {
  printf '\033[1;33mWARNING\033[0m %s\n' "$*"
}

fail() {
  printf '\033[1;31mFAILED\033[0m  %s\n' "$*"
}

check_command() {
  local command_name="$1"

  if command -v "$command_name" >/dev/null 2>&1; then
    ok "$command_name -> $(command -v "$command_name")"
  else
    fail "$command_name is missing"
  fi
}

check_link() {
  local path="$1"

  if [[ -L "$path" ]]; then
    ok "$path -> $(readlink -f "$path")"
  elif [[ -e "$path" ]]; then
    warn "$path exists but is not a symlink"
  else
    fail "$path is missing"
  fi
}

printf '\nSECTION 9 SYSTEM CHECK\n'
printf '%s\n\n' '======================'

printf 'Commands\n'
printf '%s\n' '--------'

commands=(
  Hyprland
  ags
  qs
  kitty
  nvim
  starship
  fastfetch
  eza
  bat
  fd
  rg
  fzf
  zoxide
  btop
  procs
  dust
  duf
  delta
)

for command_name in "${commands[@]}"; do
  check_command "$command_name"
done

printf '\nConfiguration links\n'
printf '%s\n' '-------------------'

links=(
  "$HOME/.config/ags"
  "$HOME/.config/hypr"
  "$HOME/.config/hyprlock"
  "$HOME/.config/kitty"
  "$HOME/.config/fastfetch"
  "$HOME/.config/nvim"
  "$HOME/.config/quickshell/section9"
  "$HOME/.config/starship.toml"
  "$HOME/.zshrc"
)

for path in "${links[@]}"; do
  check_link "$path"
done

printf '\nProcesses\n'
printf '%s\n' '---------'

if pgrep -a -f '(^|/)(ags)( |$)|-ags\.js' >/dev/null 2>&1; then
  ok "AGS is running"
else
  fail "AGS is not running"
fi

if pgrep -a -f 'qs.*section9|quickshell.*section9' >/dev/null 2>&1; then
  ok "Section 9 Quickshell is running"
else
  fail "Section 9 Quickshell is not running"
fi

if pgrep -x swaync >/dev/null 2>&1; then
  fail "SwayNC is running and may conflict with AGS"
else
  ok "SwayNC is not running"
fi

printf '\nUser services\n'
printf '%s\n' '-------------'

swaync_state="$(systemctl --user is-enabled swaync.service 2>/dev/null || true)"

case "$swaync_state" in
masked)
  ok "swaync.service is masked"
  ;;
disabled)
  warn "swaync.service is disabled but not masked"
  ;;
*)
  fail "swaync.service state: ${swaync_state:-unknown}"
  ;;
esac

printf '\nNeovim\n'
printf '%s\n' '-------'

if nvim --headless \
  "+lua local ok,err=pcall(vim.treesitter.language.add,'tsx'); if not ok then error(err) end" \
  +qa >/dev/null 2>&1; then
  ok "TSX Tree-sitter parser can load"
else
  fail "TSX Tree-sitter parser cannot load"
fi

printf '\nDone.\n'
