#!/usr/bin/env bash

set -u

log() {
  printf '\033[1;36m[SECTION 9]\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33m[WARNING]\033[0m %s\n' "$*" >&2
}

log "Stopping AGS"
ags quit 2>/dev/null || true
sleep 1

log "Stopping Quickshell"
pkill -x quickshell 2>/dev/null || true
pkill -x qs 2>/dev/null || true
sleep 1

log "Starting AGS"
(
  cd "$HOME/.config/ags" || exit 1
  nohup ags run >"$HOME/ags-error.log" 2>&1 &
)

sleep 2

log "Starting Section 9 Quickshell"
nohup qs -c section9 >"$HOME/quickshell-section9.log" 2>&1 &

sleep 2

if pgrep -a -f '(^|/)(ags)( |$)|-ags\.js' >/dev/null 2>&1; then
  log "AGS started successfully"
else
  warn "AGS did not start; inspect $HOME/ags-error.log"
fi

if pgrep -a -f 'qs.*section9|quickshell.*section9' >/dev/null 2>&1; then
  log "Quickshell started successfully"
else
  warn "Quickshell did not start; inspect $HOME/quickshell-section9.log"
fi
